# ApexAI Production — example env file for docker-compose.prod.yml
# DO NOT commit real secrets. Copy this file to .env.prod on the host.

# Database
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Vault
VAULT_TOKEN=change-me-to-a-secure-token

# Redis (no password by default in this compose; add one for prod)

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-very-long-random-secret-min-32-bytes

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://app.yourdomain.com

# Frontend → Backend URL (browser-facing)
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# --- Optional: agent LLM provider (Sub-System A) ---
# Local Ollama:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2
# MiniMax / Anthropic-compatible:
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-cp-...
# ANTHROPIC_MODEL=MiniMax-M3
# Explicit override:
# APEXAI_AGENT_MODEL=claude-sonnet-4-5