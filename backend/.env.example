# ApexAI Backend — example env file
# Copy to .env and fill in your values

# --- Core infrastructure ---
DATABASE_URL=postgresql+psycopg://apexai:apexai_dev@localhost:5433/apexai
VAULT_URL=http://localhost:8200
VAULT_TOKEN=apexai_dev_token
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-secret-change-me-in-production-please-use-32-bytes-min

# --- App config ---
APP_ENV=development
COOKIE_SECURE=false
METRICS_ENABLED=false
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# --- Agent runtime LLM provider (Sub-System A) ---
# Pick ONE (or none — final fallback is gpt-4o):
#
# 1) Local Ollama (preferred — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
#
# 2) MiniMax / Anthropic-compatible gateway
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-cp-...
# ANTHROPIC_MODEL=MiniMax-M3
#
# 3) Explicit per-org override (highest priority, picked via settings table)
# APEXAI_AGENT_MODEL=claude-sonnet-4-5
